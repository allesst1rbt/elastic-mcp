# Elasticsearch MCP Server — Environment Variables
# Copy this file to .env and fill in the values before running.

# Required: Base URL of your Elasticsearch cluster
ELASTICSEARCH_URL=https://your-elasticsearch-host:9200

# Required: Base64-encoded API key (format: id:api_key encoded in base64)
ELASTICSEARCH_API_KEY=your_base64_api_key_here

# Optional: Default index prefix used by the orchestrator to build index patterns
# Default value: platform
ELASTICSEARCH_INDEX_PREFIX=platform

# Optional: Maximum number of hits returned by search_logs (default: 100)
ELASTICSEARCH_MAX_HITS=100

# Optional: Maximum characters returned by get_trace_context (default: 8000)
ELASTICSEARCH_TRACE_MAX_CHARS=8000

# Optional: Threshold above which an error count is classified as a storm
# Applies per window defined in DLQ_STORM_WINDOW (default: 50)
DLQ_RECURRING_MAX_COUNT=50

# Optional: Time window for storm classification (Elasticsearch date math)
# Default: 1h
DLQ_STORM_WINDOW=1h
